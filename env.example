# ------------------------------------------------------------------
# Meno — copie este arquivo para .env e ajuste os valores
#   cp .env.example .env
# ------------------------------------------------------------------

# PostgreSQL (usado pelo container postgres e pelo Tandoor)
POSTGRES_DB=meno
POSTGRES_USER=meno
POSTGRES_PASSWORD=change-me

# Tandoor
# Gere uma chave com: openssl rand -hex 32
TANDOOR_SECRET_KEY=change-me

# Hosts aceitos pelo Django. "*" funciona bem em ambiente local/Codespaces.
TANDOOR_ALLOWED_HOSTS=*

# Necessário para login/POST funcionarem atrás do proxy HTTPS do Codespaces.
TANDOOR_CSRF_TRUSTED_ORIGINS=https://*.app.github.dev,http://localhost:8080,http://127.0.0.1:8080

# Portas expostas no host
TANDOOR_HTTP_PORT=8080
GROCY_HTTP_PORT=9283

# Usuário/grupo dono dos arquivos do Grocy (no Codespaces é 1000:1000)
PUID=1000
PGID=1000

# Fuso horário aplicado ao Tandoor e ao Grocy
TZ=America/Sao_Paulo
